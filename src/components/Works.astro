---
import Bars from "./Bars.astro";

import svgUnderline from "../assets/underline.svg";
import arrowCard from "../assets/arrow-card.svg";
// import { coerce } from "astro:schema";

const portfolio = [
  {
    name: "LookBook design",
    desc: `Bean & Blend, a Coffee brewing company focusing on traditional and premium coffee beans and blend.`,
    cover: `/works/LookBookTitle.webp`,
    link: "/works/LookBook.pdf",
  },
  {
    name: "Brand Identity",
    desc: `Innovathon, a 36 hours hackathon event based on software as well as hardware.`,
    cover: `/works/Innovathon.webp`,
    link: "/works/BrandIdentity.pdf",
  },
  {
    name: "Brand Guidelines",
    desc: `Nextlayer, an EdTech and deep tech company focusing on providing solutions on emerging skills.`,
    cover: `/works/brand guidelines-01 1.webp`,
    link: "/works/brandIdntityNextlayer.pdf",
  },

  {
    name: "Brand Guidelines",
    desc: `The Tatathsu collection, a hotel management group providing luxury hospitality services.`,
    cover: `/works/brand guidelines-01 2.webp`,
    link: "/works/brandIdendity2.pdf",
  },
  {
    name: "Pakaging",
    desc: `Collection of premium pakaging design from boxes to pouches.`,
    cover: `/works/7 2.webp`,
    link: "/works/pakaging.pdf",
  },
  {
    name: "PosterFolio",
    desc: `Collection of premium poster designs.`,
    cover: `/works/27 1.webp`,
    link: "/works/poster.pdf",
  },
];
---

<section class="mx-auto max-w-5xl space-y-10 px-5 py-25" id="work">
  <div class="relative mx-auto max-w-md">
    <h1 class="text-center text-4xl font-medium">My Portfolio</h1>
    <img
      src={svgUnderline.src}
      alt="arrow"
      width="140"
      class="absolute -bottom-1 left-50"
    />
  </div>

  <div class="mx-auto grid max-w-3xl grid-cols-1 gap-10 md:grid-cols-2">
    {
      portfolio.map((item) => (
        <a
          href={item.link}
          target="_blank"
          rel="noreferrer noopener"
          class="group relative flex flex-col bg-white p-5 transition-all duration-200 hover:shadow-[4px_4px_0px_rgba(0,0,0,0.3)]"
        >
          <div class="h-[200px] w-full overflow-hidden border-2">
            <img src={item.cover} alt="" class="h-full w-full object-cover" />
          </div>
          <div class="space-y-1 pt-4">
            <div class="flex pr-2">
              <h2 class="flex-1 text-xl font-medium">{item.name}</h2>
              <img src={arrowCard.src} alt="arrow" width="25" />
            </div>
            <p class="mr-20">{item.desc}</p>
          </div>
          <Bars />
        </a>
      ))
    }
  </div>
</section>
