---
import svgPinkStar from "../assets/pink-star.svg";
import Button from "./Button.astro";
import { buy1, buy2 } from "../sample";
import Button2 from "./Button2.astro";
---

<section class="mt-10 px-3" id="hire">
  <div
    class="relative mx-auto flex max-w-3xl flex-col gap-4 border-3 bg-white p-10 text-center shadow-[8px_8px_0px_rgba(0,0,0,0.3)]"
  >
    <h1
      class="text-4xl "
      style={{ fontFamily: "Mostical, sans-serif", fontWeight: 400 }}
    >
      come say hi <span style={{ fontFamily: "Helvetica", fontWeight: 400 }}
        >!</span
      >
    </h1>
    <p
      class="mx-auto max-w-lg text-lg"
      style={{ fontFamily: "Helvetica", fontWeight: 400 }}
    >
      let’s talk design, internet culture, or your latest playlist
    </p>
    <div class="flex flex-row items-center justify-center gap-4">
      <div class="flex justify-center">
        <Button2 text={buy1.title} link={buy1.link} target="_blank" />
      </div>
      <div class="flex justify-center">
        <Button text={buy2.title} link={buy2.link} target="_blank" />
      </div>
    </div>
    <img
      src={svgPinkStar.src}
      alt="svg"
      width="80"
      class="absolute -top-10 right-20"
    />
  </div>
</section>
