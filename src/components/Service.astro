---
import researchIcon from "../assets/services/research.svg";
import wireIcon from "../assets/services/wire.svg";
import uiIcon from "../assets/services/ui.svg";
import protoIcon from "../assets/services/proto.svg";

import svgPinkStar from "../assets/pink-star.svg";

const stats = [
  { name: `projects`, value: "70+" },
  { name: `Client ROI`, value: "110%" },
  { name: `Experience`, value: "4 years" },
];

const services = [
  {
    name: `Brand Identity & Logo Design`,
    desc: `Complete visual systems, from logos to brand guidelines, designed to build recognition.`,
    icon: researchIcon,
  },
  {
    name: `Graphic Design & Print Collateral`,
    desc: `Posters, brochures, packaging, and marketing assets with purpose and precision.`,
    icon: wireIcon,
  },
  {
    name: `Digital Design & Social Media Assets`,
    desc: `Engaging visuals for web, campaigns, and social platforms.`,
    icon: uiIcon,
  },
  {
    name: `Brand Strategy & Visual Direction`,
    desc: `Helping businesses define their voice and create consistent brand experiences.`,
    icon: protoIcon,
  },
];
---

<section class="relative overflow-hidden px-3 md:px-10">
  <img
    src={svgPinkStar.src}
    alt="svg"
    width="80"
    class="absolute -right-8 bottom-0"
  />

  <div class="mx-auto max-w-4xl">
    <div class="relative grid grid-cols-1 py-10 md:grid-cols-[60%_40%]">
      <div class="flex items-end">
        <h1
          class="text-4xl font-medium"
          style={{
            fontFamily: "Mostical, sans-serif",
          }}
        >
          <span>Design that makes your <br /> brand</span>
          <span class="relative">
            <span
              class="absolute bottom-0 left-0 z-1 h-[50%] w-full bg-[#BAE6FF]"
            ></span>
            <span class="relative z-5">unforgettable</span>
          </span>
        </h1>
        <svg
          class="size-20"
          viewBox="0 0 37 35"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M19.5479 4.4031C18.6713 5.80238 19.9271 9.81219 21.7001 11.2897C23.0602 12.3947 24.0665 11.888 24.3315 9.94798C24.6359 7.90326 23.1377 5.00064 21.4323 4.27109C20.1328 3.70088 19.9764 3.72964 19.5479 4.4031Z"
            fill="black"></path>
          <path
            d="M7.84038 5.33376C6.96374 6.73304 8.21957 10.7429 9.99262 12.2204C11.3527 13.3254 12.359 12.8186 12.624 10.8786C12.9284 8.83392 11.4302 5.9313 9.72476 5.20175C8.42528 4.63154 8.26883 4.66031 7.84038 5.33376Z"
            fill="black"></path>
          <path
            d="M2.88193 16.7075C3.24136 18.9226 7.35405 23.0018 11.0101 24.7375C12.1376 25.3003 14.0826 25.7031 15.8021 25.7769C18.5025 25.8751 18.8859 25.7851 22.3741 24.1786C25.7215 22.637 26.2387 22.2689 27.844 20.4042C29.889 17.9907 31.8424 12.8058 31.2223 11.3601C30.6796 10.095 29.8918 10.7176 28.3133 13.8252C26.5656 17.2272 25.5918 18.4981 23.558 19.9541C21.6144 21.3254 17.9796 22.3934 15.6935 22.2776C12.9776 22.1433 7.87127 19.3874 5.0947 16.5541C3.68105 15.1275 2.64514 15.1717 2.88193 16.7075Z"
            fill="black"></path>
        </svg>
      </div>
    </div>

    <div class="grid grid-cols-1 border-t-2 md:grid-cols-[30%_70%]">
      <div
        class="flex flex-col border-r-2 border-l-2 md:border-r-0 md:border-b-2 md:border-l-0"
      >
        {
          stats.map((item) => (
            <div class="flex flex-col p-3 last:border-none md:border-b-2 md:p-6">
              <h1
                class="text-2xl font-medium"
                style={{ fontFamily: "HelveticaBold, sans-serif" }}
              >
                {item.value}
              </h1>
              <p class="" style={{ fontFamily: "Helvetica, sans-serif" }}>
                {item.name}
              </p>
            </div>
          ))
        }
      </div>
      <div
        class="grid grid-cols-2 border-t-2 border-r-2 md:border-t-0 md:border-r-0"
      >
        {
          services.map((item) => (
            <div class="flex flex-col gap-2 border-b-2 border-l-2 p-4 md:p-6">
              <img src={item.icon.src} width="40" alt={item.name} />
              <h3
                class="text-xl font-medium"
                style={{ fontFamily: "HelveticaBold, sans-serif" }}
              >
                {item.name}
              </h3>
              <p
                class="text-xs"
                style={{ fontFamily: "Helvetica, sans-serif" }}
              >
                {item.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
