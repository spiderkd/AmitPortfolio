<Layout>
  <section class="w-full">
    <div class="flex flex-col">
      {
        frontmatter.images &&
          frontmatter.images.map((img: any) => (
            <div class="h-screen w-full">
              <Image
                src={img.url}
                alt={img.alt || "Gallery Image"}
                class="h-full w-full object-cover"
                width={1920}
                height={1080}
              />
            </div>
          ))
      }
    </div>
  </section>

  {children}
  <!-- optional slot for extra Markdown text -->
</Layout>
