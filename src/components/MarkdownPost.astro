---
import "../styles/global.css";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

import AppHeader from "./Header.astro";
import AppFooter from "./Footer.astro";
import CallToAction from "./CallToAction.astro";

const { frontmatter } = Astro.props;
---

<Layout>
  <AppHeader />

  <section class="mb-30 p-3">
    <div
      class="relative mx-auto mt-10 flex max-w-5xl flex-col gap-7 bg-white p-20 pt-14 pb-14"
    >
      <Image
        src={frontmatter.image.url}
        alt="Head"
        width={100}
        height={100}
        class="w-full border-2"
      />
      <h1 class="title text-4xl font-black">{frontmatter.title}</h1>

      <div class="flex flex-col">
        <slot />

        <div
          class="absolute bottom-0 left-[50%] w-[105%] -translate-x-[50%] rounded-full border-b-3"
        >
        </div>
        <div
          class="absolute top-0 left-[50%] w-[105%] -translate-x-[50%] rounded-full border-b-3"
        >
        </div>

        <div
          class="absolute -bottom-10 left-0 h-[105%] rounded-full border-l-3"
        >
        </div>
        <div
          class="absolute right-0 -bottom-10 h-[105%] rounded-full border-r-3"
        >
        </div>
      </div>
    </div>

    <CallToAction />
    <AppFooter />
  </section>
</Layout>
