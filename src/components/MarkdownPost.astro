---
import "../styles/global.css";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import AppHeader from "./Header.astro";
import AppFooter from "./Footer.astro";
import CallToAction from "./CallToAction.astro";

const { frontmatter } = Astro.props;
---

<Layout>
  <AppHeader />

  <section class="mb-30 p-3">
    <div
      class="relative mx-auto mt-10 mb-10 flex max-w-5xl flex-col gap-7 bg-white p-10 pt-14 pb-14 md:p-20"
    >
      {
        frontmatter.images && frontmatter.images.length > 0 && (
          <div class="flex flex-wrap">
            {frontmatter.images.map((img: any) => (
              <Image
                src={img.url}
                alt={img.alt || "Post image"}
                width={500}
                height={300}
                class="w-full object-cover md:w-[48%]"
              />
            ))}
          </div>
        )
      }
      <h1 class="title text-4xl font-black">{frontmatter.title}</h1>

      <div class="flex flex-col">
        <div
          class="max-w-none leading-relaxed [&_h1]:mt-8 [&_h1]:mb-4 [&_h1]:text-3xl [&_h1]:font-extrabold [&_h2]:mt-6 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-bold [&_h3]:mt-4 [&_h3]:mb-2 [&_h3]:text-xl [&_h3]:font-semibold [&_li]:mb-2 [&_ol]:mb-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mb-6 [&_ul]:mb-6 [&_ul]:list-disc [&_ul]:pl-6"
        >
          <slot />
        </div>
        <div
          class="absolute bottom-0 left-[50%] w-[103%] -translate-x-[50%] rounded-full border-b-3 md:w-[105%]"
        >
        </div>
        <div
          class="absolute top-0 left-[50%] w-[103%] -translate-x-[50%] rounded-full border-b-3 md:w-[105%]"
        >
        </div>

        <div
          class="absolute -bottom-[0.5%] left-0 h-[101%] rounded-full border-l-3 md:-bottom-[3%] md:h-[105%]"
        >
        </div>
        <div
          class="absolute right-0 -bottom-[0.5%] h-[101%] rounded-full border-r-3 md:-bottom-[3%] md:h-[105%]"
        >
        </div>
      </div>
    </div>

    <CallToAction />
    <AppFooter />
  </section>
</Layout>
